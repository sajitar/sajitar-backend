# Variáveis de ambiente exclusivas do desenvolvimento local.
# Este arquivo é versionado no repositório: contém apenas credenciais de dev,
# sem segredos de produção. Não use o nome `.env` para evitar confusão com
# arquivos locais não versionados que costumam guardar segredos reais.

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=sajitar-db

# pgadmin
PGADMIN_DEFAULT_EMAIL=admin@local.host
PGADMIN_DEFAULT_PASSWORD=123456

# springboot
SPRING_JPA_HIBERNATE_DDL_AUTO=create
SPRING_JPA_SHOW_SQL=true
SPRING_SQL_INIT_MODE=always
SPRING_SQL_BEFORE_FRAMEWORK=classpath:util/functions.sql
SPRING_SQL_AFTER_FRAMEWORK="util/columns.sql, util/uniques.sql, util/indexes.sql, settlement/profile.sql, settlement/checker.sql, settlement/authority.sql, settlement/note.sql"

# sajitar (validação de domínio)
SAJITAR_DOMAIN_VALIDATION_PROFILE_BIRTHDAY_MIN_AGE_YEARS=18
SAJITAR_DOMAIN_VALIDATION_LIMIT_MAX=100
