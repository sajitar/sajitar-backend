# Ambiente do job de verify no GitHub Actions e da Opção A em docs/development/commands.md.
# Credenciais só de CI/desenvolvimento — não são segredos de produção.
# O service Postgres do workflow verify.yml deve usar os mesmos POSTGRES_*.

POSTGRES_USER=sajitar_ci
POSTGRES_PASSWORD=sajitar_ci
POSTGRES_DB=sajitar_ci

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/sajitar_ci
SPRING_DATASOURCE_USERNAME=sajitar_ci
SPRING_DATASOURCE_PASSWORD=sajitar_ci
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop
SPRING_JPA_SHOW_SQL=false
SPRING_SQL_INIT_MODE=always
SPRING_SQL_BEFORE_FRAMEWORK=classpath:util/functions.sql
SPRING_SQL_AFTER_FRAMEWORK="util/columns.sql, util/uniques.sql, util/indexes.sql, settlement/profile.sql, settlement/checker.sql, settlement/authority.sql, settlement/note.sql"

SAJITAR_DOMAIN_VALIDATION_PROFILE_BIRTHDAY_MIN_AGE_YEARS=18
SAJITAR_DOMAIN_VALIDATION_LIMIT_MAX=100
SAJITAR_SECURITY_JWT_SECRET=01234567890123456789012345678901
SAJITAR_SECURITY_JWT_EXPIRATION_SECONDS=3600
SAJITAR_SECURITY_JWT_REFRESH_EXPIRATION_SECONDS=604800
